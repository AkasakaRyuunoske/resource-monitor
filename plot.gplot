# Read CSV data; skip the header row.
set datafile separator ","
set datafile columnheaders

set terminal pngcairo size 1400,900 enhanced font "Sans,10"

set output "cpu_usage.png"

set title "CPU Usage Over Time"
set xlabel "Elapsed Time (seconds)"
set ylabel "CPU Usage (%)"

set yrange [0:100]
set grid
set key top right

plot "system_usage.csv" using 2:3 \
    with lines linewidth 2 title "CPU Usage"

set output "ram_usage.png"

set title "RAM Usage Over Time"
set xlabel "Elapsed Time (seconds)"
set ylabel "RAM Used (MiB)"

set autoscale y
set grid
set key top left

plot "system_usage.csv" using 2:4 \
    with lines linewidth 2 title "RAM Used"

unset output
